[Unit]
Description=PiTouch: phone as Bluetooth touchpad and keyboard
After=bluetooth.service
Requires=bluetooth.service

[Service]
ExecStartPre=/sbin/modprobe uinput
ExecStart=/usr/bin/python3 /usr/local/lib/pitouch/pitouch_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
